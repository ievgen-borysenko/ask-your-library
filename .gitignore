# Working / scratch files (never committed)
.scratch/

# Data: demo corpus is rebuilt on demand by scripts/ingest_demo_corpus.py
data/
*.lance

# Secrets: every .env variant except the committed example
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# Chainlit runtime state (config.toml IS tracked: the UI needs unsafe_allow_html)
.chainlit/chat.db
.chainlit/chat.db-*
.chainlit/auth-secret
# Chainlit seeds this directory with a copy of every language it ships, and
# never overwrites a file that is already there — so en-US.json is ours and is
# tracked (it rewords the New Chat dialog), while the other 22 copies are not.
# The directory itself must stay unignored, or git would not descend into it to
# see the exception.
.chainlit/translations/*
!.chainlit/translations/en-US.json
# Where that copy came from and what was changed in it, next to the file itself;
# NOTICE in the repository root carries the same record.
!.chainlit/translations/README.md
.files/

# SQLite sidecars wherever they land: AYL_CHAINLIT_DIR moves the chat db out of
# .chainlit/, and a write-ahead log holds messages the .db file does not yet
*.db-wal
*.db-shm
*.db-journal

# Eval run outputs (numbers are recorded in docs/)
eval/results/

# Private session handoffs (never committed)
docs/phase*-notes.md

# local agent tooling
.claude/

# OS
.DS_Store
