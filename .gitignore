# Working / scratch files (never committed)
.scratch/

# Data: demo corpus is rebuilt on demand by scripts/ingest_demo_corpus.py
data/
*.lance

# The engineer's shelf (#58) holds no text of its own: every work is fetched
# from its publisher by scripts/fetch_tech_shelf.py and prepared locally. What
# IS committed is corpus-tech/manifest.yaml (sources, licences, checksums) and
# corpus-tech/toc/ (the chapter lists), which is the whole reviewable record.
corpus-tech/raw/
corpus-tech/prepared/

# Secrets: every .env variant except the committed example
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# Chainlit runtime state. Nothing under .chainlit/ is tracked any more (#30):
# the configuration and the reworded en-US.json are package data under
# src/ask_your_library/ui/, and launcher.py writes them into the app root it
# prepares. A .chainlit/ (and a .files/, and a chainlit.md) in the checkout is
# now what a `chainlit run` typed by hand there leaves behind — and what any
# import of chainlit in this directory leaves behind, the test suite's included:
# chainlit.config creates .files/ and seeds .chainlit/ at import time.
.chainlit/
.files/
chainlit.md

# SQLite sidecars wherever they land: AYL_CHAINLIT_DIR moves the chat db out of
# .chainlit/, and a write-ahead log holds messages the .db file does not yet
*.db-wal
*.db-shm
*.db-journal

# Eval run outputs (numbers are recorded in docs/)
eval/results/
# eval/recordings/ is deliberately NOT here: a plan recording is the INPUT a
# replayed number was produced from, not the output of a run, and a number whose
# input is not in the tree cannot be reproduced by anyone who did not pay for it.
# The half-written file of a run that died is not a record, though:
eval/recordings/*.partial

# Private session handoffs (never committed)
docs/phase*-notes.md

# local agent tooling
.claude/

# OS
.DS_Store
