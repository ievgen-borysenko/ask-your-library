# Copy to .env (gitignored) or export in your shell. All values are optional
# except OPENROUTER_API_KEY when the answering model or the embeddings come from OpenRouter
# (not needed with LLM_BACKEND=ollama and the default EMBED_BACKEND=ollama).

# LanceDB with cards_<backend> / transcripts_<backend> tables.
# Default: the demo corpus built by scripts/ingest_demo_corpus.py.
LIBRARY_DB_PATH=data/lancedb

# Embeddings: ollama (local bge-m3, default) | openrouter
EMBED_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
# Ollama 0.33 or newer for LLM_BACKEND=ollama: older builds ignore the reasoning_effort
# the client sends, and a thinking model then reasons without a bound (measured on 0.33.3).
OLLAMA_EMBED_MODEL=bge-m3

# Orchestrator LLM via OpenRouter (any OpenAI-compatible endpoint works).
# LLM_BACKEND=ollama runs the agent nodes on a local model instead: no key, no cost,
# OLLAMA_LLM_MODEL must be pulled (`ollama pull qwen2.5:14b`, 9.0 GB). In that mode the answering
# model is configured by the OLLAMA_* variables only (ORCHESTRATOR_MODEL and PRICE_* below are not
# applied; nothing goes to OpenRouter). Any other value than openrouter|ollama refuses to start.
# Numbers in the README are for OpenRouter.
LLM_BACKEND=openrouter
OLLAMA_LLM_MODEL=qwen2.5:14b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4.6
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0
# Output cap per LLM call (nodes return short JSON / short answers)
MAX_OUTPUT_TOKENS=2048
# What observe sees of each retrieved passage (ADR-012): search hit / chapter read
SEARCH_HIT_CHARS=2500
CHAPTER_HIT_CHARS=12000
# Loop budgets: steps per question, dry steps before the CRAG gate stops, books a clarify offers (1-5).
# The README numbers are for the defaults; the eval fingerprint names steps and window.
MAX_STEPS=4
MAX_EMPTY_STREAK=2
MAX_CLARIFY_CANDIDATES=5
# Time budgets: per-attempt timeout of one model call (600 by default with LLM_BACKEND=ollama),
# extra attempts on a timeout or transient error, and the per-question deadline the loop checks
# before each next decision (0 = none; the clarify pause is not counted). The deadline has no
# per-backend default: 300 s is a hosted model's budget, and a local one wants far more, which is
# why the macOS installer writes 1200 into the .env it generates for LLM_BACKEND=ollama.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
QUESTION_DEADLINE_S=300
# Opt-in fallback: file scanned for OPENROUTER_API_KEY=... (unset = disabled)
OPENROUTER_ENV_FILE=
# Embedding model when EMBED_BACKEND=openrouter
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# UI language: en (default) | ua
ASK_LANG=en

# Where the agent writes raw-hit scratchpads (a human-readable log; validate does not read them)
ASK_SCRATCH_DIR=.scratch

# Eval harness: golden set and where reports go
GOLDEN_PATH=eval/golden/en-demo.yaml
EVAL_RESULTS_DIR=eval/results

# Evidence must name the hit it was copied from; 0 resolves a missing hit id by
# the quote instead of dropping the item (still evidence-based)
AYL_STRICT_HIT_ID=1

# Optional LangSmith tracing (sends prompts and retrieved text to LangSmith).
# EU accounts also need: LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ask-your-library
# build_graph sets LANGCHAIN_TRACING_V2=true whenever LANGCHAIN_API_KEY is set; the
# SDK also reads LANGSMITH_API_KEY + LANGSMITH_TRACING[_V2], which another
# project's shell may have exported. To keep tracing off whatever the
# environment inherited, set BOTH (LANGSMITH_TRACING_V2 is read first):
# LANGSMITH_TRACING_V2=false
# LANGCHAIN_TRACING_V2=false

# Chainlit web UI login (ui.py); auth secret is generated into .chainlit/auth-secret
# unless provided here. The login form's first field is labelled "Email address";
# type the username there.
CHAINLIT_USERNAME=admin
CHAINLIT_PASSWORD=change-me
# Leave unset to have the UI generate and persist one in .chainlit/auth-secret
# CHAINLIT_AUTH_SECRET=
# The UI refuses to start with the default password; exactly 1 allows it for a
# throwaway local demo (anything else is treated as "no")
# AYL_ALLOW_DEFAULT_LOGIN=1
# Where the UI keeps its chat db and auth secret (tests and the injection canary
# point this at a temp dir so the repo's .chainlit/ is left alone)
# AYL_CHAINLIT_DIR=.chainlit
# The UI also refuses to start without an OpenRouter key when one is needed (hosted answering
# model or hosted embeddings), so a missing key is reported before anyone logs in; 1 allows
# importing ui.py without one (tests)
# AYL_ALLOW_START_WITHOUT_KEY=1
# The login cookie is SameSite=strict, which ui.py sets on Chainlit's cookie module itself.
# CHAINLIT_COOKIE_SAMESITE is deliberately not listed here: `chainlit run` has already read it
# before ui.py is loaded, so neither this file nor an exported value decides the policy.
